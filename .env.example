# ============================================================
# Production app environment.
# Copy this file to .env and fill in your values.
# Dev-only overrides live in .env.dev.
# Sync-test credentials live in .env.tests.
# ============================================================

# Database Configuration
DATABASE_NAME=arena_db
DATABASE_USER=user
# IMPORTANT: change before any non-local deployment.
DATABASE_PASSWORD=password
DATABASE_HOST=wf-db
DATABASE_ECHO=false

# Arena API Configuration
ARENA_API_FORMAT=json

# Application Configuration
APP_DEBUG=false
# Set to false to disable rate limiting (e.g. in test environments)
RATE_LIMIT_ENABLED=true
# Set to false to skip sending emails (useful for local development)
SEND_EMAILS=true
# Must be true in production (requires HTTPS)
COOKIE_SECURE=true

# JWT Configuration
# REQUIRED: generate a fresh secret with `openssl rand -hex 32` before deploying.
# The app refuses to start when this still contains the placeholder text.
JWT_SECRET_KEY=your-secret-key-change-this-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Frontend Configuration
FRONTEND_URL=https://your-domain.example
# Comma-separated list of allowed CORS/CSRF origins
ALLOWED_ORIGINS=https://your-domain.example
# Comma-separated list of hostnames TrustedHostMiddleware will accept in the
# `Host` header. Leave as `*` only for local dev; in production list real
# hostnames (e.g. yourdomain.com,api.yourdomain.com).
ALLOWED_HOSTS=*

# Email Configuration (SMTP)
# For Gmail: use App Password — https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Wrestling Federation

# Google OAuth2 Configuration
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
